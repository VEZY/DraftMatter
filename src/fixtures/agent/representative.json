      "actor": { "id": "agent:analyst", "name": "Local research assistant" },
      "language": "python",
      "role": "figure",
      "source": "plot_response(data)",
      "selector": { "kind": "section-label", "label": "sec-results" },
      "placement": "end",
      "caption": "Treatment response by date.",
      "alt": "Lines show the response through time for each treatment."
    }
  },
  {
    "name": "reproducible table and named values",
    "request": {
      "protocolVersion": "1.0",
      "domain": "computation",
      "action": "create",
      "mode": "apply",
      "expectedRevision": "sha256:current",
      "idempotencyKey": "table-summary-001",
      "actor": { "id": "agent:analyst", "name": "Local research assistant" },
      "language": "r",
      "role": "table",
      "source": "summary_table <- analyse(data)",
      "selector": { "kind": "heading", "text": "Results" },
      "placement": "end",
      "caption": "Model estimates.",
