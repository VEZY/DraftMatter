[Unit]
Description=Expire DraftMatter backup staging archives after 29 days
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=/etc/draftmatter/backup-schedule.env
ExecStart=/bin/sh /usr/local/lib/draftmatter/server-backup.sh ${DM_BACKUP_RELEASE_DIRECTORY} /etc/draftmatter /var/backups/draftmatter prune
TimeoutStartSec=10min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
StandardOutput=journal
StandardError=journal
