FROM node:24.22.3-bookworm-slim AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

# Only browser inputs: no operator runtime.env or deployment credentials.
COPY index.html vite.config.ts tsconfig.app.json ./
COPY LICENSE ./
COPY src ./src
COPY public ./public
COPY integrations ./integrations

# Generic release: public deployment settings arrive at container startup.
ENV VITE_DM_RUNTIME_PUBLIC_CONFIG=true
RUN npm run check && npx vite build

FROM caddy:2.11.9-alpine AS caddy
RUN if getcap /usr/bin/caddy | grep -q .; then setcap -r /usr/bin/caddy; fi

FROM node:24.22.3-alpine AS runtime

ENV NODE_ENV=production XDG_CONFIG_HOME=/config XDG_DATA_HOME=/data
RUN mkdir -p /data /config /opt/draftmatter/deploy/production /opt/draftmatter/src \
    && chown -R 1000:1000 /data /config
COPY --from=caddy /usr/bin/caddy /usr/bin/caddy
COPY --from=caddy /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /app/dist /srv/draftmatter
COPY deploy/production/Caddyfile /etc/caddy/Caddyfile
COPY deploy/production/routes.caddy /etc/caddy/routes.caddy
COPY deploy/production/public-config.mjs /opt/draftmatter/deploy/production/public-config.mjs
COPY src/publicConfigurationModel.mjs /opt/draftmatter/src/publicConfigurationModel.mjs
COPY deploy/production/web-entrypoint.sh /usr/local/bin/draftmatter-web
COPY LICENSE compliance/THIRD_PARTY_NOTICES.md /usr/share/doc/draftmatter/

EXPOSE 8080 8443
USER 1000:1000
ENTRYPOINT ["/bin/sh", "/usr/local/bin/draftmatter-web"]
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
