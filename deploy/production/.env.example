# Copy outside the checkout, e.g. /etc/draftmatter/production.env (chmod 600).
# This template deliberately fails deploy:check until every REPLACE value is set.
# Values are literal: do not use $VARIABLE expansion. Percent-encode DB credentials.
APP_HOST=REPLACE_APP_HOST
COLLABORATION_HOST=REPLACE_COLLABORATION_HOST
ACME_EMAIL=REPLACE_ACME_EMAIL
RELEASE_ID=REPLACE_RELEASE_ID

# Public legal information: compiled into the app, never put credentials here.
# Name and contact below were selected for the free closed alpha.
DM_LEGAL_PUBLISHER_NAME='Rémi Vezy'
DM_LEGAL_CONTACT_EMAIL=vezy.remi@gmail.com
# Provider legal identity, address and contact only. No technical server details.
# The country statement must be short, in English, and match the actual hosting.
# Only after confirming both facts: Hosted in France by a French company.
DM_LEGAL_HOSTING_DETAILS='REPLACE_CONFIRMED_HOSTING_PROVIDER_COORDINATES'
DM_LEGAL_DATA_LOCATION='REPLACE_CONFIRMED_SHORT_HOSTING_STATEMENT'
DM_LEGAL_ADDITIONAL_PROCESSORS='Google (Gmail) for contact messages; do not attach manuscripts or research data.'

DM_DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_DATABASE_HOST:5432/REPLACE_DATABASE
DM_DATABASE_TLS=verify-full
DM_OBJECT_BUCKET=REPLACE_PRIVATE_BUCKET
DM_OBJECT_REGION=REPLACE_BUCKET_REGION
DM_OBJECT_PREFIX=draftmatter
# Leave endpoint empty for AWS S3. Other providers need an HTTPS endpoint.
DM_OBJECT_ENDPOINT=
DM_OBJECT_FORCE_PATH_STYLE=false
DM_OBJECT_ACCESS_KEY=REPLACE_OBJECT_ACCESS_KEY
DM_OBJECT_SECRET_KEY=REPLACE_OBJECT_SECRET_KEY

# Public, HTTPS issuer and JWKS, reachable from both clients and the service.
# The IdP must include this API audience in access tokens by default.
DM_OIDC_ISSUER=https://REPLACE_IDENTITY_HOST/realms/draftmatter
DM_OIDC_JWKS_URI=https://REPLACE_IDENTITY_HOST/realms/draftmatter/protocol/openid-connect/certs
DM_OIDC_AUDIENCE=draftmatter-collaboration
DM_OIDC_CLIENT_ID=draftmatter-public
DM_ALLOWED_ORIGINS=https://REPLACE_APP_HOST,tauri://localhost,http://tauri.localhost
# Generate independently, e.g. openssl rand -base64 48 (never reuse a fixture secret).
DM_WEBHOOK_SECRET=REPLACE_RANDOM_WEBHOOK_SECRET
DM_MAX_PAYLOAD_BYTES=16777216

# Optional email provider: configure all three together, or leave all empty.
DM_NOTIFICATION_WEBHOOK_URL=
DM_NOTIFICATION_WEBHOOK_SECRET=
DM_PUBLIC_APP_URL=
