(draftmatter_app) {
	root * /srv/draftmatter
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	}
	# Documents, PDF previews and isolated computation output never need active
	# plugins or executable inline scripts. WASM is used by document/PDF tooling.
	@application not path /demo /demo/*
	header @application Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data: blob:; connect-src 'self' https: wss: http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*; frame-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self' {$DM_PUBLIC_AUTH_ORIGIN}; frame-ancestors 'none'"
	# The public example is isolated from identity/collaboration providers and
	# external citation services. It loads only its own static assets and WASM.
	@demo path /demo /demo/*
	header @demo Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data: blob:; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"

	# A missing build asset must be a 404, never the SPA entrypoint.
	@privateInternal path /internal /internal/*
	handle @privateInternal {
		respond "Not found" 404
	}
	handle /draftmatter-public-config.json {
		root * /tmp
		header Cache-Control no-store
		header Content-Type application/json
		file_server
	}
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	@staticFile {
		path_regexp staticFile \.[A-Za-z0-9]+$
		# Dotted project IDs are valid application routes, not static files.
		not path /index.html /workspace/* /local/* /learn/*
	}
	handle @staticFile {
		header Cache-Control "public, max-age=3600"
		file_server
	}
	handle {
		header Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}
	handle_errors {
		# A missing chunk must not retain the immutable cache policy of /assets/.
		header Cache-Control no-store
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}

(draftmatter_sync) {
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000"
	}
	# Scrape this on the private Docker network, not through the public proxy.
	@privateInternal path /internal /internal/*
	handle @privateInternal {
		respond "Not found" 404
	}
	handle /metrics* {
		respond "Not found" 404
	}
	@filePart {
		method PUT
		path_regexp filePart ^/api/workspaces/[^/]+/projects/[^/]+/files/uploads/[^/]+/parts/[1-9][0-9]{0,3}$
	}
	handle @filePart {
		request_body {
			max_size 8388608
		}
		reverse_proxy collaboration:1234
	}
	handle {
		# HTTP administration accepts 64 KiB. WebSocket frame limits are enforced
		# separately by DM_MAX_PAYLOAD_BYTES and are not HTTP request bodies.
		request_body {
			max_size 65536
		}
		# Caddy forwards WebSocket upgrades without rewriting their paths.
		reverse_proxy collaboration:1234
	}
}

# Imported only by the single-host identity virtual host. Caddy forward_auth
# clones the request with method GET: the password body remains exclusively on
# the original request subsequently sent to Keycloak. No user credentials or
# Keycloak action-token query parameters go to the admission service.
(draftmatter_identity_admission) {
	route {
		request_body {
			max_size 65536
		}
		forward_auth collaboration:1234 {
			uri /internal/identity-admission?kind={args[0]}
			header_up -Authorization
			header_up -Cookie
			header_up -Content-Type
			header_up -Content-Length
			header_up -X-Forwarded-Uri
			header_up -X-Forwarded-Method
			header_up X-DM-Identity-Admission "{$DM_IDENTITY_ADMISSION_TOKEN}"
			header_up X-DM-Identity-IP {remote_host}
			transport http {
				dial_timeout 3s
				response_header_timeout 5s
			}
		}
		reverse_proxy keycloak:8080 {
			header_up -X-DM-Identity-Admission
			header_up -X-DM-Identity-IP
		}
	}
}
