{
  "realm": "draftmatter",
  "enabled": true,
  "displayName": "DraftMatter local development",
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "clients": [
    {
      "clientId": "draftmatter-local",
      "name": "DraftMatter local client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:4173/*", "http://127.0.0.1:4173/*"],
      "webOrigins": ["http://localhost:4173", "http://127.0.0.1:4173"],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "draftmatter audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "draftmatter-local",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@example.test",
      "firstName": "Alice",
      "lastName": "Researcher",
      "credentials": [{ "type": "password", "value": "alice-local-only", "temporary": false }]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "email": "bob@example.test",
      "firstName": "Bob",
      "lastName": "Reviewer",
      "credentials": [{ "type": "password", "value": "bob-local-only", "temporary": false }]
    }
  ]
}
