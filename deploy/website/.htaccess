# The free web host serves static files; authentication and research data live elsewhere.
DirectoryIndex index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} !^www\.draftmatter\.eu$ [NC,OR]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://www.draftmatter.eu%{REQUEST_URI} [R=301,L,NE]
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  <FilesMatch "^(index\.html|draftmatter-deployment\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
