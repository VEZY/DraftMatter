{
  "name": "draftmatter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "draftmatter": "dist-cli/draftmatter.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:collaboration && npm run build:cli && tsc -p tsconfig.app.json --noEmit && vite build",
    "build:collaboration": "npm run check:service && vite build --config vite.service.config.ts && node scripts/copy-collaboration-assets.mjs",
    "build:cli": "vite build --config vite.cli.config.ts",
    "collaboration:start": "node dist-service/main.js",
    "preview": "vite preview",
    "check": "tsc -p tsconfig.app.json --noEmit",
    "check:service": "tsc -p services/collaboration/tsconfig.json --noEmit",
    "compliance:generate": "node scripts/generate-compliance.mjs",
    "compliance:check": "node scripts/generate-compliance.mjs --verify",
    "pack:cli": "npm pack ./dist-cli",
    "release:verify": "node scripts/verify-release.mjs",
    "test": "vitest run src services",
    "test:alpha": "vitest run src/phase7AlphaDogfood.test.ts",
    "test:cli": "node scripts/verify-cli.mjs",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:release": "npm run release:verify && npm run check && npm test && npm run test:e2e && npm run build && npm run test:cli && npm run compliance:check",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1087.0",
    "@citeproc-rs/wasm": "0.2.0",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@hocuspocus/provider": "4.4.0",
    "@hocuspocus/server": "4.4.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@types/mdast": "4.0.4",
    "@vitejs/plugin-react": "latest",
    "jose": "6.2.3",
    "katex": "^0.17.0",
    "pg": "8.22.0",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-view": "^1.42.1",
    "react": "latest",
    "react-dom": "latest",
    "remark-parse": "11.0.0",
    "typescript": "latest",
    "unified": "11.0.5",
    "vite": "latest",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.31"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "axe-core": "^4.12.1",
    "jsdom": "^29.1.1",
    "pg-mem": "3.0.14",
    "vitest": "^4.1.10"
  }
}
