{
  "name": "draftmatter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "draftmatter": "dist-cli/draftmatter.js"
  },
  "scripts": {
    "dev": "vite",
    "dev:website": "vite --config vite.website.config.ts",
    "build": "npm run build:collaboration && npm run build:cli && tsc -p tsconfig.app.json --noEmit && vite build",
    "build:website": "npm run check:website && vite build --config vite.website.config.ts",
    "build:collaboration": "npm run check:service && vite build --config vite.service.config.ts && node scripts/copy-collaboration-assets.mjs",
    "build:cli": "vite build --config vite.cli.config.ts",
    "collaboration:start": "node dist-service/main.js",
    "benchmark:collaboration": "node scripts/benchmark-collaboration.mjs",
    "deploy:check": "node scripts/check-production-config.mjs",
    "preview": "vite preview",
    "preview:website": "vite preview --config vite.website.config.ts",
    "check": "tsc -p tsconfig.app.json --noEmit",
    "check:website": "tsc -p tsconfig.website.json --noEmit",
    "check:service": "tsc -p services/collaboration/tsconfig.json --noEmit",
    "compliance:generate": "node scripts/generate-compliance.mjs",
    "compliance:check": "node scripts/generate-compliance.mjs --verify",
    "fixture:sync": "node scripts/sync-complete-example-manifests.mjs",
    "fixture:check": "node scripts/sync-complete-example-manifests.mjs --check",
    "pack:cli": "npm pack ./dist-cli",
    "release:verify": "node scripts/verify-release.mjs",
    "release:all": "gh workflow run server-release.yml --repo VEZY/DraftMatter --ref main -f include_desktop=true",
    "release:server": "gh workflow run server-release.yml --repo VEZY/DraftMatter --ref main -f version=",
    "test": "vitest run src services website --exclude \"tests/e2e/**\" --maxWorkers=1 --testTimeout=15000",
    "test:alpha": "vitest run src/phase7AlphaDogfood.test.ts src/phase7AlphaAuthoringGate.test.ts --maxWorkers=1 --testTimeout=15000",
    "test:cli": "node scripts/verify-cli.mjs",
    "test:mcp": "node scripts/verify-mcp.mjs",
    "test:agent-service": "vitest run src/agentProtocol.test.ts src/agentService.test.ts",
    "test:agent-cli": "node scripts/verify-cli.mjs",
    "test:agent-e2e": "node scripts/verify-agent-e2e.mjs",
    "build:agent-host": "cargo build --manifest-path src-tauri/Cargo.toml --locked --bin draftmatter-agent-host",
    "build:desktop-sidecars": "node scripts/build-desktop-sidecars.mjs",
    "test:agent-host": "node scripts/verify-agent-host.mjs",
    "test:agent-adapters": "node scripts/verify-agent-adapters.mjs",
    "test:agent-clients": "node scripts/verify-installed-agent-clients.mjs",
    "test:agent-performance": "node scripts/verify-agent-performance.mjs",
    "agent:sync": "node scripts/sync-agent-integrations.mjs",
    "validate:agent-skill": "node scripts/validate-agent-integrations.mjs",
    "test:e2e": "playwright test",
    "test:e2e:website": "playwright test --config playwright.website.config.ts",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:website:update": "playwright test --config playwright.website.config.ts --update-snapshots",
    "test:release": "npm run release:verify && npm run check && npm test && npm run test:e2e && npm run test:e2e:website && npm run build && npm run test:cli && npm run test:mcp && npm run test:agent-adapters && npm run test:agent-performance && npm run validate:agent-skill && npm run compliance:check",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "deploy:single-host:init": "node scripts/init-single-host.mjs",
    "deploy:single-host:check": "node scripts/check-single-host.mjs",
    "test:deployment": "vitest run services/collaboration/singleHost*.test.mjs services/collaboration/serverRelease*.test.mjs services/collaboration/rehearsalOrchestration.test.mjs services/collaboration/migrationPackaging.test.mjs services/collaboration/productionDeployment.test.mjs src/publicRuntimeConfiguration.test.ts --maxWorkers=1 && node --test deploy/single-host/backup/backup.test.mjs",
    "test:deployment:smoke": "node scripts/smoke-single-host.mjs",
    "test:backup-offhost": "node --test deploy/offhost-mac/*.test.mjs && python3 -B -m unittest discover -s deploy/single-host/backup -p 'test_*.py'",
    "deploy:single-host:rehearse": "node scripts/rehearse-single-host.mjs",
    "deploy:single-host:tls": "node scripts/renew-single-host-tls.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1087.0",
    "@citeproc-rs/wasm": "0.2.0",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@hocuspocus/provider": "4.4.0",
    "@hocuspocus/server": "4.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "jose": "6.2.3",
    "katex": "^0.19.1",
    "nodemailer": "10.6.0",
    "pdfjs-dist": "6.5.438",
    "pg": "8.22.0",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "^1.42.3",
    "re2js": "2.10.0",
    "react": "latest",
    "react-dom": "latest",
    "remark-parse": "11.0.0",
    "toml-eslint-parser": "^0.10.1",
    "unified": "11.0.5",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.31",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/mdast": "4.0.4",
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "6.0.3",
    "axe-core": "^4.12.1",
    "jsdom": "^29.1.1",
    "pg-mem": "3.0.14",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "^4.1.10"
  }
}
