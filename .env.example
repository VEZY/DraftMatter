# Development-only Compose credentials. Replace every value before a public deployment.
POSTGRES_PASSWORD=change-this-postgres-password
KEYCLOAK_ADMIN_PASSWORD=change-this-keycloak-password
OBJECT_ACCESS_KEY=draftmatter-local
OBJECT_SECRET_KEY=change-this-object-storage-secret
WEBHOOK_SECRET=change-this-webhook-secret-with-at-least-32-bytes

# Standalone collaboration image configuration (Compose supplies local equivalents).
DM_DATABASE_URL=postgres://draftmatter:change-this@postgres.example.test/draftmatter
DM_DATABASE_TLS=verify-full
DM_OBJECT_BUCKET=draftmatter
DM_OBJECT_REGION=us-east-1
DM_OBJECT_PREFIX=draftmatter
DM_OIDC_ISSUER=https://identity.example.test/realms/draftmatter
DM_OIDC_JWKS_URI=https://identity.example.test/realms/draftmatter/protocol/openid-connect/certs
DM_OIDC_AUDIENCE=draftmatter-collaboration
DM_ALLOWED_ORIGINS=https://app.example.test
DM_WEBHOOK_SECRET=change-this-independent-32-byte-webhook-secret
