# Development-only Compose credentials. Replace every value before a public deployment.
POSTGRES_PASSWORD=change-this-postgres-password
KEYCLOAK_ADMIN_PASSWORD=change-this-keycloak-password
OBJECT_ACCESS_KEY=draftmatter-local
OBJECT_SECRET_KEY=change-this-object-storage-secret
WEBHOOK_SECRET=change-this-webhook-secret-with-at-least-32-bytes

# Standalone collaboration image configuration (Compose supplies local equivalents).
DM_DATABASE_URL=postgres://draftmatter:change-this@postgres.example.test/draftmatter
DM_DATABASE_TLS=verify-full
DM_OBJECT_BUCKET=draftmatter
DM_OBJECT_REGION=us-east-1
DM_OBJECT_PREFIX=draftmatter
DM_OIDC_ISSUER=https://identity.example.test/realms/draftmatter
DM_OIDC_JWKS_URI=https://identity.example.test/realms/draftmatter/protocol/openid-connect/certs
DM_OIDC_AUDIENCE=draftmatter-collaboration
DM_OIDC_CLIENT_ID=draftmatter-browser
DM_ALLOWED_ORIGINS=https://app.example.test
DM_WEBHOOK_SECRET=change-this-independent-32-byte-webhook-secret
DM_MAINTENANCE_INTERVAL_MS=86400000

# Optional managed review-email delivery. Configure all three together.
DM_NOTIFICATION_WEBHOOK_URL=https://mail-adapter.example.test/draftmatter
DM_NOTIFICATION_WEBHOOK_SECRET=change-this-separate-32-byte-delivery-secret
DM_PUBLIC_APP_URL=https://app.example.test
DM_NOTIFICATION_INTERVAL_MS=30000

# Public metadata, included in the website/app browser bundle (never use secrets).
# The local legal pages explicitly remain in preparation until hosting is filled.
VITE_DM_LEGAL_PUBLISHER_NAME='Rémi Vezy'
VITE_DM_LEGAL_CONTACT_EMAIL=vezy.remi@gmail.com
# Hosting provider's legal name, address and contact only; no server architecture.
VITE_DM_LEGAL_HOSTING_DETAILS=
# Short English statement of the confirmed hosting country and provider status.
# Until hosting is selected, leave empty: the legal pages show the planned hosting.
VITE_DM_LEGAL_DATA_LOCATION=
VITE_DM_LEGAL_ADDITIONAL_PROCESSORS='Google (Gmail) for messages sent to the alpha contact address.'
