{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DraftMatter",
  "version": "0.1.0",
  "identifier": "org.draftmatter.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DraftMatter",
        "width": 1440,
        "height": 960,
        "minWidth": 880,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["draftmatter"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A living manuscript for research",
    "longDescription": "Local-first scientific writing, citations, executable results, review, and explicit versioning.",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
